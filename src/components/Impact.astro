---
import { impact } from '../data/career';
---

<section class="impact">
  <h2 class="section-h">Impacto</h2>
  <p class="section-sub">Lo que se repite en cada equipo por el que pasé.</p>
  <div class="impact-grid">
    {
      impact.map((i) => (
        <div class="impact-card">
          <div class="ic">{i.icon}</div>
          <h3>{i.title}</h3>
          <p>{i.text}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .impact { padding: 80px var(--gutter); max-width: 1180px; margin: 0 auto; }
  .impact-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .impact-card { padding: 28px 24px; border-radius: 18px; border: 1px solid var(--line); background: var(--panel); display: flex; flex-direction: column; gap: 16px; }
  .ic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; background: linear-gradient(135deg, var(--indigo-2), var(--pink)); font-size: 20px; }
  h3 { font-size: 18px; letter-spacing: -.01em; }
  p { color: var(--muted); line-height: 1.55; font-size: 15px; font-weight: 300; }

  @media (max-width: 760px) {
    .impact-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 480px) {
    .impact-grid { grid-template-columns: 1fr; }
  }
</style>
