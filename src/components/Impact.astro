---
import { impact } from '../data/career';
import { ui, type Locale } from '../i18n';

const { lang } = Astro.props as { lang: Locale };
const t = ui[lang];
---

<section class="impact">
  <h2 class="section-h">{t.impactTitle}</h2>
  <p class="section-sub">{t.impactSub}</p>
  <div class="impact-grid">
    {
      impact.map((i, n) => (
        <div class="impact-item">
          <span class="mono n">{String(n + 1).padStart(2, '0')}</span>
          <h3>{i.title[lang]}</h3>
          <p>{i.text[lang]}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .impact { padding: 80px var(--gutter); max-width: 1180px; margin: 0 auto; }
  .impact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 32px; }
  .impact-item { padding-top: 20px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 10px; }
  .n { color: var(--indigo); }
  h3 { font-size: 17px; letter-spacing: -.01em; }
  p { color: var(--muted); line-height: 1.6; font-size: 15px; font-weight: 300; }

</style>
