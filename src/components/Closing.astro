---
import { links } from '../data/career';
import { ui, type Locale } from '../i18n';
import cv from '../assets/curriculum-es.pdf?url';

const { lang } = Astro.props as { lang: Locale };
const t = ui[lang];

// 24x24 icon paths: mail and file (Lucide, stroked), LinkedIn and GitHub (Simple Icons, filled).
const items = [
  { label: t.email, href: `mailto:${links.email}`, external: false, stroke: true, d: 'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm18 2-10 7L2 6' },
  { label: 'LinkedIn', href: links.linkedin, external: true, stroke: false, d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z' },
  { label: 'GitHub', href: links.github, external: true, stroke: false, d: 'M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3z' },
  { label: t.cv, href: cv, external: true, stroke: true, d: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8M8 9h2' },
];
---

<section class="close">
  <h2>{t.closeTitle}</h2>
  <p>{t.closeText}</p>
  <div class="links">
    {
      items.map((i) => (
        <a href={i.href} aria-label={i.label} title={i.label} {...(i.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill={i.stroke ? 'none' : 'currentColor'} stroke={i.stroke ? 'currentColor' : 'none'} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d={i.d} />
          </svg>
        </a>
      ))
    }
  </div>
</section>

<style>
  .close { padding: 80px var(--gutter) 120px; max-width: 1180px; margin: 0 auto; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(28px, 3.4vw, 40px); font-weight: 600; letter-spacing: -.02em; }
  p { color: var(--muted); margin: 16px 0 32px; max-width: 54ch; line-height: 1.7; font-weight: 300; }
  .links { display: flex; gap: 12px; }
  .links a { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 8px; border: 1px solid var(--line); color: var(--muted); transition: border-color .2s, color .2s; }
  .links a:hover, .links a:focus-visible { border-color: var(--indigo); color: var(--text); }
</style>
