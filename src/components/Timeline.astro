---
import {
  milestones,
  parallelRole,
  branchIndex,
  alongside,
  formatPeriod,
  formatRange,
  formatWhen,
  yearOf,
} from '../data/career';

const listFormat = new Intl.ListFormat('es', { type: 'conjunction' });
const alongsideParts = listFormat.formatToParts(alongside);
---

<section class="timeline-wrap">
  <h2 class="section-h">Trayectoria</h2>
  <p class="section-sub">Cada paso sumó algo distinto: ojo de diseño, velocidad de agencia, liderazgo técnico, escala enterprise y docencia.</p>

  <div class="timeline" id="timeline">
    <div class="rail"><div class="rail-fill" id="rail-fill"></div></div>
    <div class="par-rail" id="par-rail" aria-hidden="true"></div>

    {
      milestones.map((m, i) => (
        <>
          {i === branchIndex && (
            <div class="item branch" id="branch">
              <div class="year">{parallelRole.start[0]}</div>
              <div class="node" />
              <button class="branch-note" type="button" data-open-peek>
                <span class="mono">{formatWhen(parallelRole.start)}</span> Se abre una vía en paralelo: docencia en {parallelRole.company} <span aria-hidden="true">↗</span>
              </button>
            </div>
          )}
          <div class:list={['item', { current: !m.end }]}>
            <div class="year">{yearOf(m.start)}</div>
            <div class="node" />
            <article class="card">
              <span class="mono period">{formatPeriod(m.start, m.end)}</span>
              {!m.end && <span class="badge">ahora</span>}
              <h3>
                {m.company}
                {m.companyNote && <span class="company-note">· {m.companyNote}</span>}
              </h3>
              <h4>{m.subtitle}</h4>
              {m.description && <p>{m.description}</p>}
              {m.subRoles && (
                <div class="sub-roles">
                  {m.subRoles.map((r) => (
                    <div>
                      <strong>{r.title}</strong>
                      <span>{formatRange(r.start, r.end)} · {r.summary}</span>
                    </div>
                  ))}
                </div>
              )}
              {m.chips && (
                <div class="chips">
                  {m.chips.map((c) => <span>{c}</span>)}
                </div>
              )}
            </article>
          </div>
        </>
      ))
    }
  </div>
</section>

<aside class="peek" id="peek" aria-label={`En paralelo: ${parallelRole.company}`}>
  <div class="peek-inner">
    <button class="peek-tab" id="peek-tab" type="button" aria-expanded="false" aria-controls="peek-body"><i></i><span>En paralelo</span></button>
    <div class="peek-body" id="peek-body">
      <div class="peek-head">
        <div class="peek-logo">{parallelRole.company[0]}</div>
        <div><h3>{parallelRole.company}</h3><h4>{parallelRole.title}</h4></div>
      </div>
      <span class="mono period" id="peek-period" data-start={parallelRole.start.join('-')}>{formatRange(parallelRole.start)}</span>
      <p>{parallelRole.description}</p>
      <p class="while">
        En simultáneo con {alongsideParts.map((part) => (part.type === 'element' ? <b>{part.value}</b> : part.value))}.
      </p>
    </div>
  </div>
</aside>

<script>
  import { formatDuration } from '../data/career';

  const progress = document.getElementById('progress');
  const timeline = document.getElementById('timeline')!;
  const fill = document.getElementById('rail-fill')!;
  const parRail = document.getElementById('par-rail')!;
  const firstNode = timeline.querySelector<HTMLElement>('.item .node')!;
  const branchNode = document.querySelector<HTMLElement>('#branch .node')!;
  const peek = document.getElementById('peek')!;
  const peekTab = document.getElementById('peek-tab')!;
  const peekPeriod = document.getElementById('peek-period')!;

  // Parallel rail spans from the current node down to the branch node (minus the curve).
  const centerY = (el: HTMLElement) => {
    const r = el.getBoundingClientRect();
    return r.top + r.height / 2 - timeline.getBoundingClientRect().top;
  };
  const layoutParRail = () => {
    const top = centerY(firstNode);
    const bottom = centerY(branchNode) - 14;
    parRail.style.top = `${top}px`;
    parRail.style.height = `${Math.max(0, bottom - top)}px`;
  };

  const setOpen = (open: boolean) => {
    peek.classList.toggle('open', open);
    peekTab.setAttribute('aria-expanded', String(open));
    parRail.classList.toggle('lit', open);
  };

  // The tab peeks in only while the viewport's middle is within the parallel period.
  const updatePeek = () => {
    const r = parRail.getBoundingClientRect();
    const mid = innerHeight / 2;
    const inRange = r.top < mid && r.bottom + 14 > mid;
    peek.classList.toggle('show', inRange);
    if (!inRange && peek.classList.contains('open')) setOpen(false);
  };

  const onScroll = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    if (progress) progress.style.transform = `scaleX(${scrollY / max})`;
    const r = timeline.getBoundingClientRect();
    const pct = Math.min(1, Math.max(0, (innerHeight * 0.6 - r.top) / r.height));
    fill.style.height = `${pct * 100}%`;
    updatePeek();
  };

  peekTab.addEventListener('click', () => setOpen(!peek.classList.contains('open')));
  document.querySelector('[data-open-peek]')?.addEventListener('click', () => {
    peek.classList.add('show');
    setOpen(true);
  });
  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (!peek.contains(target) && !target.closest('[data-open-peek]')) setOpen(false);
  });
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });

  // Ongoing duration is computed in the browser so it doesn't freeze at build time.
  const [sy, sm] = (peekPeriod.dataset.start ?? '').split('-').map(Number);
  const now = new Date();
  peekPeriod.textContent += ` · ${formatDuration((now.getFullYear() - sy) * 12 + (now.getMonth() + 1 - sm) + 1)}`;

  layoutParRail();
  addEventListener('resize', () => { layoutParRail(); onScroll(); });
  document.fonts.ready.then(() => { layoutParRail(); onScroll(); });
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (e.isIntersecting) e.target.closest('.item')?.classList.add('in');
    }),
    { rootMargin: '0px 0px -35% 0px' },
  );
  document.querySelectorAll('.item .card, .item .branch-note').forEach((el) => io.observe(el));
</script>

<style>
  .timeline-wrap { padding: 80px var(--gutter) 40px; max-width: 1180px; margin: 0 auto; }
  .timeline { position: relative; --main-x: 200px; --par-x: 216px; }
  .rail { position: absolute; top: 0; bottom: 56px; left: calc(var(--main-x) - 1px); width: 2px; background: var(--line); }
  .rail-fill { position: absolute; top: 0; left: 0; width: 100%; height: 0; background: linear-gradient(var(--indigo), var(--pink)); box-shadow: 0 0 12px var(--indigo); }

  .item { display: grid; grid-template-columns: 180px 40px 1fr; }
  .year { grid-column: 1; text-align: right; padding: 4px 0 0; position: sticky; top: 90px; align-self: start; font-weight: 800; font-size: 44px; letter-spacing: -.04em; color: #2c2c4a; transition: color .5s; }
  .item.in .year { color: var(--text); }
  .node { grid-column: 2; justify-self: center; margin-top: 18px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line); z-index: 2; transition: .4s; position: relative; }
  .item.in .node { border-color: var(--indigo); background: var(--indigo); box-shadow: 0 0 0 6px #818cf822; }
  .item.current .node::after { content: ""; position: absolute; inset: -8px; border-radius: 50%; border: 2px solid var(--indigo); animation: ring 1.8s infinite; }
  @keyframes ring { from { opacity: 1; transform: scale(.6); } to { opacity: 0; transform: scale(1.6); } }

  .card { grid-column: 3; margin: 0 0 56px 8px; padding: 26px 28px; background: linear-gradient(160deg, #16162c, #10101f); border: 1px solid var(--line); border-radius: 18px; opacity: .25; transform: translateX(24px); transition: opacity .7s, transform .7s cubic-bezier(.2,.7,.2,1), border-color .3s; }
  .item.in .card { opacity: 1; transform: none; }
  .card:hover { border-color: #4a4a7a; }
  .card .period { color: var(--indigo); }
  .card h3 { font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -.02em; margin: 8px 0 2px; }
  .company-note { color: var(--muted); font-weight: 400; }
  .card h4 { font-weight: 400; color: var(--muted); font-size: 16px; }
  .card p { margin-top: 14px; line-height: 1.65; color: #c6c6e0; font-weight: 300; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .chips span { font-family: var(--mono); font-size: 12px; padding: 4px 10px; border-radius: 99px; border: 1px solid var(--line); color: var(--muted); }
  .badge { display: inline-block; font-family: var(--mono); font-size: 11px; padding: 3px 9px; border-radius: 99px; background: #818cf822; color: var(--indigo); border: 1px solid #818cf855; margin-left: 8px; vertical-align: middle; }
  .sub-roles { margin-top: 16px; display: grid; gap: 10px; border-left: 2px solid var(--line); padding-left: 16px; }
  .sub-roles strong { display: block; font-weight: 600; }
  .sub-roles span { color: var(--muted); font-size: 14px; }

  /* Parallel track: a dashed rail that branches off the main one and runs to today */
  .par-rail { position: absolute; left: var(--par-x); top: 0; height: 0; border-left: 2px dashed currentColor; color: #f472b655; pointer-events: none; transition: color .5s, filter .5s; }
  .par-rail::after { content: ""; position: absolute; bottom: -14px; left: calc(var(--main-x) - var(--par-x) - 2px); width: calc(var(--par-x) - var(--main-x) + 2px); height: 14px; border: 2px dashed currentColor; border-top: 0; border-left: 0; border-bottom-right-radius: 12px; }
  .par-rail::before { content: ""; position: absolute; top: -4px; left: -5px; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .par-rail.lit { color: var(--pink); filter: drop-shadow(0 0 6px #f472b6aa); }

  .branch .year { font-size: 28px; padding-top: 2px; }
  .branch.in .year { color: #f472b6aa; }
  .branch .node { width: 10px; height: 10px; margin-top: 14px; }
  .branch.in .node { background: var(--bg); border-color: var(--pink); box-shadow: none; }
  .branch-note { grid-column: 3; justify-self: start; margin: 6px 0 56px 8px; padding: 8px 14px; font: 300 15px var(--sans); color: var(--muted); background: none; border: 1px dashed #f472b644; border-radius: 99px; cursor: pointer; opacity: .25; transition: opacity .7s, color .3s, border-color .3s; text-align: left; }
  .item.in .branch-note { opacity: 1; }
  .branch-note .mono { color: var(--pink); font-size: 12px; margin-right: 6px; }
  .branch-note:hover { color: var(--text); border-color: var(--pink); }

  /* Peeking side tab: sits mostly off-screen while the parallel period is in view */
  .peek { --ty: -50%; --peek: 84px; position: fixed; right: 0; top: 50%; z-index: 40; width: 340px; max-width: calc(100vw - 24px); display: flex; transform: translate(100%, var(--ty)); opacity: 0; pointer-events: none; transition: transform .7s cubic-bezier(.2,.7,.2,1), opacity .4s; }
  .peek.show { transform: translate(calc(100% - var(--peek)), var(--ty)); opacity: 1; pointer-events: auto; }
  .peek.show:not(.open):hover { transform: translate(calc(100% - var(--peek) - 28px), var(--ty)); }
  .peek.show.open { transform: translate(0, var(--ty)); }
  .peek-inner { display: flex; width: 100%; filter: drop-shadow(0 20px 40px #0009); }
  .peek.show:not(.open) .peek-inner { animation: nudge 6s 1.2s infinite; }
  @keyframes nudge { 0%, 86%, 100% { transform: none; } 91% { transform: translateX(-10px); } 95% { transform: translateX(-3px); } }
  .peek-tab { flex: none; width: 34px; display: grid; place-items: center; gap: 8px; padding: 14px 0; background: #241631; border: 1px solid #f472b655; border-right: 0; border-radius: 14px 0 0 14px; color: var(--pink); cursor: pointer; font: 500 11px var(--mono); letter-spacing: .14em; text-transform: uppercase; }
  .peek-tab span { writing-mode: vertical-rl; transform: rotate(180deg); }
  .peek-tab i { width: 6px; height: 6px; border-radius: 50%; background: var(--pink); animation: blinkdot 1.6s infinite; }
  @keyframes blinkdot { 50% { opacity: .3; } }
  .peek-body { flex: 1; min-width: 0; padding: 18px 20px 20px; background: linear-gradient(160deg, #1d1428f2, #120f1ef2); backdrop-filter: blur(10px); border: 1px solid #f472b633; border-left: 0; }
  .peek-head { display: flex; align-items: center; gap: 12px; }
  .peek-logo { flex: none; width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; font-weight: 800; background: linear-gradient(135deg, #f472b6, #a855f7); }
  .peek-head h3 { font-size: 18px; letter-spacing: -.01em; }
  .peek-head h4 { font-weight: 400; color: var(--muted); font-size: 13px; }
  .peek-body .period { display: block; color: var(--pink); font-size: 12px; margin: 14px 0 6px; }
  .peek-body p { color: #c6c6e0; font-weight: 300; font-size: 14px; line-height: 1.6; }
  .peek-body .while { margin-top: 12px; font-size: 12.5px; color: var(--muted); border-top: 1px dashed #f472b633; padding-top: 10px; }
  .peek-body .while b { color: var(--text); font-weight: 600; }
  .peek-body > :not(.peek-head) { transition: opacity .4s; }
  .peek:not(.open) .peek-body > :not(.peek-head) { opacity: .35; }

  @media (max-width: 760px) {
    .timeline { --main-x: 12px; --par-x: 25px; }
    .item { grid-template-columns: 24px 1fr; }
    .year { grid-column: 2; position: static; text-align: left; padding: 0 0 8px 12px; font-size: 32px; color: var(--text); }
    .node { grid-column: 1; grid-row: 2; margin-top: 12px; width: 14px; height: 14px; }
    .card { grid-column: 2; grid-row: 2; margin: 0 0 40px 16px; padding: 20px; transform: translateY(16px); }
    .branch-note { grid-column: 2; grid-row: 2; margin: 6px 0 40px 16px; font-size: 14px; }
    .branch .year { font-size: 24px; }
    .peek { --ty: 0; --peek: 48px; top: auto; bottom: 20px; width: 300px; }
  }
</style>
