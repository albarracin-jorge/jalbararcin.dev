---
import { careerStart } from '../data/career';
import photo from '../assets/profile.jpg';
import { ui, type Locale } from '../i18n';

const { lang } = Astro.props as { lang: Locale };
const t = ui[lang];
---

<header class="hero" id="hero">
  <div class="photo" aria-hidden="true">
    <img src={photo.src} width={photo.width} height={photo.height} alt="" fetchpriority="high" />
  </div>
  <div class="hero-inner">
    <div class="copy">
    <span class="mono eyebrow">{t.eyebrow}</span>
    <h1>{t.heroTitle}</h1>
    <p>{t.heroText}</p>
    <dl class="facts">
      <div><dt class="mono">{t.factNow}</dt><dd>{t.factNowValue}</dd></div>
      <div><dt class="mono">{t.factFocus}</dt><dd>{t.factFocusValue}</dd></div>
      <div><dt class="mono">{t.factExp}</dt><dd><span id="years" data-since={careerStart.join('-')}>5+</span> {t.factExpSuffix}</dd></div>
      <div><dt class="mono">{t.factAlso}</dt><dd>{t.factAlsoValue}</dd></div>
    </dl>
    </div>
  </div>
  <span class="scroll-hint mono">{t.scroll}</span>
</header>

<script>
  // Computed in the browser so the count doesn't freeze at build time.
  const years = document.getElementById('years');
  if (years?.dataset.since) {
    const [y, m] = years.dataset.since.split('-').map(Number);
    years.textContent = `${Math.floor((Date.now() - new Date(y, m - 1).getTime()) / (365.25 * 864e5))}+`;
  }

  // Fade the whole hero out once less than a third of it is on screen, and back in when it returns.
  const hero = document.getElementById('hero');
  if (hero) {
    new IntersectionObserver(([e]) => hero.classList.toggle('out', !e.isIntersecting), { threshold: 0.5 }).observe(hero);
  }
</script>

<style>
  .hero { min-height: 100svh; display: grid; place-items: center; padding: 80px var(--gutter); position: relative; overflow: hidden; transition: opacity .3s ease; }
  .hero.out { opacity: 0; }
  /* Entrance: copy slides in from the left, photo from the right. */
  @keyframes slide-from-left { from { opacity: 0; transform: translateX(-48px); } }
  @keyframes slide-from-right { from { opacity: 0; transform: translateX(48px); } }
  .hero-inner { animation: slide-from-left 1s cubic-bezier(.2,.7,.2,1) backwards; }
  .photo { animation: slide-from-right 1s cubic-bezier(.2,.7,.2,1) backwards; }
  @media (prefers-reduced-motion: reduce) { .hero { transition: none; } .hero-inner, .photo { animation: none; } }
  /* Photo sits in the background on the right and fades into the page on its left and bottom edges only; it bleeds off the right edge. */
  .photo { position: absolute; top: 0; right: 0; bottom: 0; width: calc(min(41.8%, 605px) * 1.3); pointer-events: none;
    -webkit-mask-image: radial-gradient(circle farthest-side at 100% 40%, #000 78.5%, transparent 100%), linear-gradient(to bottom, #000 80%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: radial-gradient(circle farthest-side at 100% 40%, #000 78.5%, transparent 100%), linear-gradient(to bottom, #000 80%, transparent);
    mask-composite: intersect; }
  /* Oversized (140% of the original, now 107.7% of the 1.3x-wider block) and right-anchored, so the face sits 20% of the block further left without exposing an edge. */
  .photo :global(img) { position: absolute; right: 0; top: 0; width: 107.7%; max-width: none; height: 100%; object-fit: cover; object-position: 50% 30%; filter: grayscale(.8) brightness(.7) contrast(1.05); opacity: .85; }
  .hero-inner { position: relative; max-width: calc(1180px - 2 * var(--gutter)); width: 100%; margin: 0 auto; }
  /* Copy is pushed to the left column to balance the photo's visual weight. */
  .copy { max-width: min(640px, 56%); }
  .eyebrow { color: var(--muted); letter-spacing: .12em; text-transform: uppercase; }
  h1 { font-size: clamp(34px, 5vw, 68px); line-height: 1.06; font-weight: 600; letter-spacing: -.035em; margin: 20px 0 28px; }
  p { font-size: clamp(16px, 1.4vw, 18px); color: var(--muted); line-height: 1.7; font-weight: 300; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; margin-top: 44px; padding-top: 24px; border-top: 1px solid var(--line); }
  .facts dt { color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .1em; font-size: 11px; }
  .facts dd { line-height: 1.45; font-size: 15px; }
  .scroll-hint { position: absolute; bottom: 28px; left: 50%; transform: translateX(-50%); color: var(--muted); opacity: .6; z-index: 1; }

  @media (max-width: 860px) {
    .copy { max-width: min(640px, 100%); }
    .photo { width: 100%; opacity: .35; -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 35%, #000 20%, transparent 80%); mask-image: radial-gradient(ellipse 80% 60% at 50% 35%, #000 20%, transparent 80%); }
  }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } }
</style>
