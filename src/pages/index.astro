---
import { defaultLocale, locales } from '../i18n';
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=/${defaultLocale}/`} />
    <title>Jorge Albarracín</title>
    {locales.map((l) => <link rel="alternate" hreflang={l} href={`https://albarracin.dev/${l}/`} />)}
    <script is:inline>
      // Spanish for any Spanish browser, English otherwise.
      var lang = (navigator.language || 'es').slice(0, 2) === 'es' ? 'es' : 'en';
      location.replace('/' + lang + '/' + location.search + location.hash);
    </script>
  </head>
  <body>
    <a href="/es/">Español</a> · <a href="/en/">English</a>
  </body>
</html>
