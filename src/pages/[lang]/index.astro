---
import type { GetStaticPaths } from 'astro';
import MainLayout from '../../layout/MainLayout.astro';
import Hero from '../../components/Hero.astro';
import Timeline from '../../components/Timeline.astro';
import Impact from '../../components/Impact.astro';
import NiceToKnow from '../../components/NiceToKnow.astro';
import Closing from '../../components/Closing.astro';
import { locales, type Locale } from '../../i18n';

export const getStaticPaths = (() => locales.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---

<MainLayout lang={lang}>
  <div class="progress" id="progress"></div>
  <Hero lang={lang} />
  <Timeline lang={lang} />
  <Impact lang={lang} />
  <NiceToKnow lang={lang} />
  <Closing lang={lang} />
</MainLayout>
